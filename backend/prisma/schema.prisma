generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Subject {
  programming
  security_privacy
  refactoring
}

enum Language {
  c
  cpp
  python
  java
  javascript
  go
}

enum Level {
  entry
  working
  professional
}

enum QuestionType {
  single
  multiple
  judgment
}

enum QuestionStatus {
  draft
  published
  archived
}

enum Role {
  learner
  content_admin
  system_admin
}

enum IpRoleBindingRole {
  learner
  content_admin
}

enum ExamStatus {
  in_progress
  submitted
  abandoned
}

enum AuditAction {
  ip_role_upsert
  ip_role_delete
  question_import
  question_archive
  data_clear
  exam_config_reload
}

model Visitor {
  id               String            @id @default(uuid()) @db.Uuid
  ip               String            @unique @db.Inet
  firstSeenAt      DateTime          @default(now())
  lastSeenAt       DateTime          @default(now())
  practiceAttempts PracticeAttempt[]
  mistakes         Mistake[]
  bookmarks        Bookmark[]
  examAttempts     ExamAttempt[]

  @@index([lastSeenAt])
}

model IpRoleBinding {
  id          String   @id @default(uuid()) @db.Uuid
  ip          String   @unique @db.Inet
  role        IpRoleBindingRole
  note        String?  @db.VarChar(200)
  updatedByIp String   @db.Inet
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([role])
  @@index([updatedByIp])
  @@index([updatedAt])
}

model Question {
  id               String            @id @default(uuid()) @db.Uuid
  sourceCode       String?           @unique @db.VarChar(120)
  subject          Subject
  language         Language?
  level            Level
  type             QuestionType
  stemMd           String            @db.Text
  options          Json
  correctAnswers   String[]          @default([])
  explanationMd    String?           @db.Text
  memo             String?           @db.VarChar(200)
  tags             String[]          @default([])
  totalAttempts    Int               @default(0)
  correctAttempts  Int               @default(0)
  status           QuestionStatus    @default(draft)
  createdByIp      String            @db.Inet
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  practiceAttempts PracticeAttempt[]
  mistakes         Mistake[]
  bookmarks        Bookmark[]

  @@index([status, subject, language, level, type])
  @@index([subject, language, level, status])
  @@index([type, status])
  @@index([createdAt])
  @@index([updatedAt])
  @@index([tags], type: Gin)
}

model PracticeAttempt {
  id           String   @id @default(uuid()) @db.Uuid
  visitorId    String   @db.Uuid
  questionId   String   @db.Uuid
  selectedKeys String[] @default([])
  isCorrect    Boolean
  mode         String   @default("practice") @db.VarChar(32)
  durationSec  Int?
  createdAt    DateTime @default(now())
  visitor      Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  question     Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@index([visitorId, createdAt])
  @@index([questionId, createdAt])
  @@index([visitorId, questionId, createdAt])
}

model Mistake {
  id                      String    @id @default(uuid()) @db.Uuid
  visitorId               String    @db.Uuid
  questionId              String    @db.Uuid
  wrongCount              Int       @default(0)
  consecutiveCorrectCount Int       @default(0)
  isMastered              Boolean   @default(false)
  lastWrongAt             DateTime?
  masteredAt              DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  visitor                 Visitor   @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  question                Question  @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([visitorId, questionId])
  @@index([visitorId, isMastered, lastWrongAt])
  @@index([questionId])
  @@index([updatedAt])
}

model Bookmark {
  id         String   @id @default(uuid()) @db.Uuid
  visitorId  String   @db.Uuid
  questionId String   @db.Uuid
  note       String?  @db.VarChar(500)
  tags       String[] @default([])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  visitor    Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([visitorId, questionId])
  @@index([visitorId, createdAt])
  @@index([questionId])
  @@index([tags], type: Gin)
}

model ExamAttempt {
  id                 String     @id @default(uuid()) @db.Uuid
  visitorId          String     @db.Uuid
  subject            Subject
  language           Language?
  level              Level
  configSnapshot     Json
  questionSnapshot   Json
  answers            Json
  flaggedQuestionIds String[]   @default([])
  status             ExamStatus @default(in_progress)
  scorePercent       Decimal?   @db.Decimal(5, 2)
  isPassed           Boolean?
  startedAt          DateTime   @default(now())
  deadlineAt         DateTime
  submittedAt        DateTime?
  updatedAt          DateTime   @updatedAt
  visitor            Visitor    @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([visitorId, status, startedAt])
  @@index([subject, language, level, status])
  @@index([startedAt])
  @@index([submittedAt])
}

model AuditLog {
  id        String      @id @default(uuid()) @db.Uuid
  actorIp   String      @db.Inet
  role      Role
  action    AuditAction
  target    String      @db.VarChar(200)
  detail    Json?
  createdAt DateTime    @default(now())

  @@index([createdAt])
  @@index([actorIp, createdAt])
  @@index([action, createdAt])
}
